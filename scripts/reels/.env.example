# Copy this file to scripts/reels/.env and fill in the values.
# scripts/reels/.env is git-ignored; never commit real credentials.

# PostgreSQL database that the scripts read from and write to
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thesis_db
DB_USER=
DB_PASSWORD=

# Object storage (S3-compatible, e.g. Cloudflare R2) for reel media.
# Only needed by the scripts that upload media; same values as backend/.env.
CDN_ENDPOINT=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_BUCKET_NAME=
CDN_PUBLIC_URL=
