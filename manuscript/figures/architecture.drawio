        <!-- Frontend -> Backend -->
        <mxCell id="e1" value="REST / JSON&lt;br&gt;JWT bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="backend">
