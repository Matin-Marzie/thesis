<mxfile host="app.diagrams.net" version="24.7.5">
  <diagram name="System Architecture" id="glosy-architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Mobile Frontend -->
        <mxCell id="frontend" value="Mobile Frontend&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React Native (Expo SDK 54)&lt;br&gt;Android / iOS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Backend API -->
        <mxCell id="backend" value="Backend API&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Node.js / Express (ESM)&lt;br&gt;&lt;b&gt;api.glosy.gr&lt;/b&gt;&lt;br&gt;Auth (JWT), Vocabulary,&lt;br&gt;Progress Sync, Dictionary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;arcSize=12;" vertex="1" parent="1">
